---
interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  activeNav?: string;
  isHome?: boolean;
}
const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  activeNav = '',
  isHome = false,
} = Astro.props;

const navItems = [
  { key: 'services',  label: 'Services',   href: '/pages/services'  },
  { key: 'portfolio', label: 'Portfolio',   href: '/pages/portfolio' },
  { key: 'rallies',   label: 'Rallies™',   href: '/pages/rallies'   },
  { key: 'about',     label: 'About',       href: '/pages/about'     },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {isHome && <meta name="google-site-verification" content="HT-yX6Z6H1M4-M52oV3d-eFzNHMmurC6wWvSxYd0x9M" />}
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <meta name="geo.region" content="SG" />
  <meta name="geo.placename" content="Singapore" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Elitez Events" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDescription || description} />
  <meta property="og:image" content="https://events.elitez.asia/assets/img/og-image.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle || title} />
  <meta name="twitter:description" content={ogDescription || description} />
  <meta name="twitter:image" content="https://events.elitez.asia/assets/img/og-image.jpg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/assets/fonts/fonts.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />

  <!-- Google tag (gtag.js) — shared Elitez Ads account, same base tag as fmcg.elitez.ai -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-629589652"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-629589652');
    // Enquiry-form conversion: FormSubmit redirects to /pages/contact?sent=1 on success.
    // Paste the Events "Enquiry Form Submit" conversion label below to activate reporting.
    var AW_CONVERSION_LABEL = 'YPhiCOao0uQcEJSNm6wC'; // Events — Enquiry Form Submit
    if (AW_CONVERSION_LABEL && window.location.search.indexOf('sent=1') !== -1) {
      gtag('event', 'conversion', { send_to: 'AW-629589652/' + AW_CONVERSION_LABEL });
    }
  </script>

  <script is:inline defer src="/assets/js/analytics.js"></script>
  <script is:inline defer src="/assets/js/animations.js"></script>
  <slot name="head" />
</head>
<body>

  <nav class="nav">
    <a href="/" class="nav-logo">
      <img src="/assets/img/logo-white.png" alt="Elitez Events" onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
      <span class="nav-logo-text" style="display:none">Elitez <em>Events</em></span>
    </a>
    <ul class="nav-links">
      {navItems.map(item => (
        <li><a href={item.href} class={activeNav === item.key ? 'active' : ''}>{item.label}</a></li>
      ))}
      <li><a href="/pages/contact" class:list={['nav-cta', { active: activeNav === 'contact' }]}>Get a Quote</a></li>
    </ul>
    <button class="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
  </nav>

  <slot />

  <footer class="footer">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="/assets/img/logo-white.png" alt="Elitez Events" class="footer-logo" onerror="this.style.display='none'" />
        <p class="footer-tagline">"We stage moments that matter."</p>
        <div class="footer-social">
          <a href="https://www.instagram.com/elitez_events_sg/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        </div>
      </div>
      <div>
        <div class="footer-col-title">Services</div>
        <ul class="footer-col-links">
          <li><a href="/pages/services#dd">Dinner &amp; Dance</a></li>
          <li><a href="/pages/services#awards">Awards Ceremonies</a></li>
          <li><a href="/pages/services#familyday">Family Day</a></li>
          <li><a href="/pages/services#conferences">Conferences</a></li>
          <li><a href="/pages/rallies">Rallies™</a></li>
          <li><a href="/pages/services#teambuilding">Team Building</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-col-title">Company</div>
        <ul class="footer-col-links">
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/portfolio">Portfolio</a></li>
          <li><a href="/pages/about#team">Our Team</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="https://fmcg.elitez.ai">Elitez FMCG ↗</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-col-title">Contact</div>
        <div class="footer-contact-item">
          <div class="footer-contact-label">Address</div>
          <div class="footer-contact-value">2 Kallang Avenue #03-08<br />CT Hub, Singapore 188613</div>
        </div>
        <div class="footer-contact-item">
          <div class="footer-contact-label">Email</div>
          <div class="footer-contact-value"><a href="mailto:eevann.seah@elitez.asia">eevann.seah@elitez.asia</a></div>
        </div>
        <div class="footer-contact-item">
          <div class="footer-contact-label">Phone</div>
          <div class="footer-contact-value"><a href="tel:+6581800994">+65 8180 0994</a></div>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">© 2026 Elitez Events. Part of <span>Elitez Group of Companies</span>.</div>
      <div class="footer-legal">
        <a href="/pages/privacy">Privacy Policy</a>
      </div>
    </div>
  </footer>

  <script is:inline src="/assets/js/main.js"></script>
</body>
</html>
