---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Elitez Events — Singapore Corporate Events Agency"
  description="Elitez Events — Singapore's corporate events agency. D&D, awards ceremonies, family days, conferences and Rallies™. Trusted by DSTA, SingHealth, Mandai and more."
  canonical="https://events.elitez.asia"
  ogTitle="Elitez Events — Singapore Corporate Events Agency"
  ogDescription="D&D, awards ceremonies, family days, conferences and Rallies™. Trusted by DSTA, SingHealth, Mandai Wildlife Group and 60+ clients."
  activeNav=""
  isHome={true}
>
  <Fragment slot="head">
    <style is:global>
      /* ── HERO ───────────────────────────────────────── */
      .hero {
        position: relative;
        height: 100vh;
        min-height: 700px;
        display: flex;
        align-items: center;
        overflow: hidden;
      }
      .hero-bg {
        position: absolute;
        inset: 0;
        background: var(--midnight);
      }
      .hero-bg::before {
        content: '';
        position: absolute;
        top: 0; right: 0;
        width: 44%;
        height: 100%;
        background: var(--navy);
        clip-path: polygon(14% 0, 100% 0, 100% 100%, 0% 100%);
      }
      .hero-bg::after {
        content: '';
        position: absolute;
        top: 0;
        left: 56%;
        width: 2px;
        height: 100%;
        background: linear-gradient(to bottom, transparent 0%, var(--gold) 20%, var(--gold) 80%, transparent 100%);
        transform: skewX(-4deg);
        opacity: 0.6;
      }
      .hero-glow {
        position: absolute;
        top: 50%; left: 22%;
        transform: translate(-50%,-50%);
        width: 560px; height: 560px;
        background: radial-gradient(ellipse, rgba(201,146,58,0.06) 0%, transparent 70%);
        pointer-events: none;
      }
      .hero-vert {
        position: absolute;
        right: 28px;
        top: 50%;
        transform: translateY(-50%) rotate(90deg);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: rgba(240,235,224,0.1);
        white-space: nowrap;
        pointer-events: none;
        z-index: 1;
      }
      .hero-rule {
        position: absolute;
        left: var(--pad-x); right: var(--pad-x);
        height: 1px;
        background: var(--border);
        opacity: 0.5;
      }
      .hero-rule-top    { top: 112px; }
      .hero-rule-bottom { bottom: 148px; }

      .hero-content {
        position: relative;
        z-index: 2;
        padding: 0 var(--pad-x);
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
      }
      .hero-left {
        animation: slideIn 1.1s 0.1s var(--ease-out) both;
      }
      @keyframes slideIn {
        from { opacity: 0; transform: translateX(-28px); }
        to   { opacity: 1; transform: translateX(0); }
      }
      .hero-headline {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(52px, 7.5vw, 112px);
        line-height: 0.93;
        letter-spacing: -0.01em;
        color: var(--cream);
      }
      .hero-headline .line-italic { font-style: italic; display: block; }
      .hero-headline .line-gold   { font-style: italic; color: var(--gold); display: block; }

      .hero-right {
        display: flex;
        flex-direction: column;
        gap: 36px;
        animation: fadeUp 1.1s 0.3s var(--ease-out) both;
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .hero-sub {
        font-size: 15px;
        font-weight: 300;
        color: var(--steel);
        line-height: 1.85;
      }
      .hero-mini-stats {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }
      .hero-mini-num {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 28px;
        line-height: 1;
        color: var(--cream);
      }
      .hero-mini-lbl {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--steel);
        margin-top: 3px;
      }
      .hero-scroll {
        position: absolute;
        bottom: 40px; left: var(--pad-x);
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 2;
        animation: fadeUp 1.1s 0.6s both;
      }
      .hero-scroll-line {
        width: 48px; height: 1px;
        background: linear-gradient(to right, var(--gold), transparent);
      }
      .hero-scroll-lbl {
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--steel);
      }

      /* ── SERVICES ───────────────────────────────────── */
      .services-layout {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 96px;
        align-items: start;
      }
      .services-intro { position: sticky; top: 100px; }
      .services-intro .section-body { margin-top: 20px; font-size:15px; font-weight:300; color:var(--steel); line-height:1.85; }
      .services-intro .btn { margin-top: 32px; }

      .service-list { border-top: 1px solid var(--border); }
      .service-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 32px 0;
        border-bottom: 1px solid var(--border);
        position: relative;
        overflow: hidden;
        transition: padding-left 0.38s cubic-bezier(0.4,0,0.2,1);
        cursor: default;
        text-decoration: none;
        color: inherit;
      }
      .service-row::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 0;
        background: var(--gold);
        transition: width 0.38s cubic-bezier(0.4,0,0.2,1);
      }
      .service-row:hover { padding-left: 24px; }
      .service-row:hover::before { width: 3px; }

      .service-row-left { display: flex; align-items: baseline; gap: 28px; }
      .service-num {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 13px;
        color: var(--steel);
        flex-shrink: 0;
        transition: color 0.28s;
      }
      .service-row:hover .service-num { color: var(--gold); }
      .service-name {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 30px;
        line-height: 1.1;
        color: var(--cream);
        transition: color 0.28s;
      }
      .service-row:hover .service-name { color: #fff; }
      .service-row-right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
      .service-row-desc {
        font-size: 13px;
        font-weight: 300;
        color: var(--steel);
        max-width: 220px;
        line-height: 1.6;
        text-align: right;
        opacity: 0;
        transform: translateX(8px);
        transition: opacity 0.35s, transform 0.35s;
      }
      .service-row:hover .service-row-desc { opacity: 1; transform: none; }
      .service-tag {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        border: 1px solid var(--gold-border);
        padding: 5px 12px;
        white-space: nowrap;
        opacity: 0;
        transform: translateX(8px);
        transition: opacity 0.35s 0.05s, transform 0.35s 0.05s;
      }
      .service-row:hover .service-tag { opacity: 1; transform: none; }

      /* ── WHY US ─────────────────────────────────────── */
      .why-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 96px;
        align-items: start;
      }
      .why-items { display: flex; flex-direction: column; }
      .why-item {
        display: grid;
        grid-template-columns: 56px 1fr;
        gap: 24px;
        padding: 32px 0;
        border-bottom: 1px solid var(--border);
      }
      .why-item:first-child { border-top: 1px solid var(--border); }
      .why-num {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 28px;
        color: var(--gold);
        line-height: 1;
        padding-top: 4px;
      }
      .why-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 18px;
        color: var(--cream);
        margin-bottom: 8px;
      }
      .why-desc { font-size: 13px; font-weight: 300; color: var(--steel); line-height: 1.8; }

      .why-aside { position: sticky; top: 100px; }
      .quote-block {
        border-left: 3px solid var(--gold);
        padding: 28px 0 28px 36px;
        margin-bottom: 44px;
      }
      .quote-text {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 24px;
        line-height: 1.45;
        color: var(--cream);
        margin-bottom: 20px;
      }
      .quote-attr {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--steel);
      }
      .quote-attr span { color: var(--gold); }

      .team-strip { display: flex; flex-direction: column; }
      .team-member {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }
      .team-member:last-child { border-bottom: none; }
      .team-avatar {
        width: 40px; height: 40px;
        background: var(--gold-dim);
        border: 1px solid var(--gold-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-style: italic;
        font-size: 16px;
        color: var(--gold);
        flex-shrink: 0;
      }
      .team-name { font-size: 14px; font-weight: 500; color: var(--cream); }
      .team-role { font-size: 11px; font-weight: 300; color: var(--steel); margin-top: 1px; }

      /* ── PORTFOLIO TEASER ───────────────────────────── */
      .portfolio-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 48px;
        gap: 24px;
      }
      .btn-text-arrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--gold);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        transition: gap 0.28s;
      }
      .btn-text-arrow:hover { gap: 14px; }

      .portfolio-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        grid-template-rows: auto auto;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
      }
      .port-card {
        background: var(--navy);
        position: relative;
        overflow: hidden;
      }
      .port-card:first-child { grid-row: span 2; }
      .port-img {
        width: 100%;
        aspect-ratio: 4/3;
        position: relative;
        overflow: hidden;
        background: var(--midnight);
      }
      .port-card:first-child .port-img { aspect-ratio: unset; height: 100%; min-height: 320px; }
      .port-img img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease-out);
      }
      .port-card:hover .port-img img { transform: scale(1.04); }
      /* Placeholder gradient shown when no photo yet */
      .port-img-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .port-img-placeholder::after {
        content: attr(data-label);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(240,235,224,0.2);
      }
      .port-card:nth-child(1) .port-img-placeholder { background: linear-gradient(145deg,#1a1428 0%,#0d0e22 50%,#1a100a 100%); }
      .port-card:nth-child(2) .port-img-placeholder { background: linear-gradient(145deg,#0e1820 0%,#0a1218 100%); }
      .port-card:nth-child(3) .port-img-placeholder { background: linear-gradient(145deg,#1c1208 0%,#0e0c18 100%); }
      .port-card:nth-child(4) .port-img-placeholder { background: linear-gradient(145deg,#0c1a14 0%,#081018 100%); }
      .port-card:nth-child(5) .port-img-placeholder { background: linear-gradient(145deg,#14100a 0%,#1c1420 100%); }

      .port-meta {
        padding: 18px 24px 20px;
      }
      .port-card:first-child .port-meta { padding: 22px 28px 24px; }
      .port-type {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 4px;
      }
      .port-name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 17px;
        color: var(--cream);
        line-height: 1.25;
        margin-bottom: 4px;
      }
      .port-card:first-child .port-name { font-size: 22px; }
      .port-detail { font-size: 12px; font-weight: 300; color: var(--steel); }

      /* Gold highlight on hover */
      .port-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(201,146,58,0.04);
        opacity: 0;
        transition: opacity 0.35s;
        pointer-events: none;
      }
      .port-card:hover::after { opacity: 1; }

      /* ── RESPONSIVE OVERRIDES ───────────────────────── */
      @media (max-width: 1024px) {
        .services-layout { grid-template-columns: 1fr; gap: 56px; }
        .services-intro { position: static; }
        .why-layout { grid-template-columns: 1fr; gap: 56px; }
        .why-aside { position: static; }
      }
      @media (max-width: 768px) {
        .hero-content { grid-template-columns: 1fr; gap: 40px; }
        .hero-mini-stats { display: none; }
        .hero-rule { display: none; }
        .hero-vert { display: none; }
        .portfolio-grid { grid-template-columns: 1fr 1fr; }
        .port-card:first-child { grid-row: span 1; }
        .port-card:first-child .port-img { min-height: auto; }
      }
      @media (max-width: 480px) {
        .portfolio-grid { grid-template-columns: 1fr; }
        .service-row-right { display: none; }
      }
    </style>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://events.elitez.asia/#website",
          "url": "https://events.elitez.asia/",
          "name": "Elitez Events",
          "publisher": { "@id": "https://events.elitez.asia/#business" }
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://events.elitez.asia/#business",
          "name": "Elitez Events",
          "description": "Singapore corporate events agency — Dinner & Dance, awards ceremonies, family days, conferences, team building and Rallies™, a proprietary corporate pickleball tournament format.",
          "url": "https://events.elitez.asia",
          "logo": "https://events.elitez.asia/assets/img/logo-white.png",
          "image": "https://events.elitez.asia/assets/img/og-image.jpg",
          "email": "eevann.seah@elitez.asia",
          "telephone": "+6581800994",
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "SG",
            "addressLocality": "Singapore"
          },
          "areaServed": { "@type": "Country", "name": "Singapore" },
          "parentOrganization": {
            "@type": "Organization",
            "name": "Elitez Group",
            "url": "https://elitez.asia"
          },
          "sameAs": [
            "https://elitez.asia"
          ],
          "serviceType": ["Corporate Dinner & Dance", "Awards Ceremonies", "Family Day Events", "Conferences & Seminars", "Team Building", "Rallies™ Corporate Pickleball"],
          "slogan": "We stage moments that matter.",
          "knowsAbout": ["Corporate event management", "Dinner and dance planning", "Awards ceremony production", "Corporate sports events", "Pickleball tournaments"]
        }
      ]
    }
    </script>
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-glow"></div>
    <div class="hero-vert">Singapore · Corporate Events · Since 2015</div>
    <div class="hero-rule hero-rule-top"></div>
    <div class="hero-rule hero-rule-bottom"></div>
    <div class="hero-content">
      <div class="hero-left">
        <div class="eyebrow" style="margin-bottom:32px;">Singapore Corporate Events Agency</div>
        <h1 class="hero-headline">
          We Stage
          <span class="line-italic">Moments</span>
          <span class="line-gold">That Matter</span>
        </h1>
      </div>
      <div class="hero-right">
        <p class="hero-sub">From 800-seat gala dinners to 1,500-person Dinner &amp; Dances — we design corporate events that your people will still talk about next year.</p>
        <div class="btn-pair">
          <a href="/pages/contact" class="btn btn-gold">
            Start Your Event
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/pages/portfolio" class="btn btn-ghost">
            View Portfolio
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="hero-mini-stats">
          <div>
            <div class="hero-mini-num">1,400 pax</div>
            <div class="hero-mini-lbl">DSTA D&amp;D · Marina Bay Sands</div>
          </div>
          <div>
            <div class="hero-mini-num">1,500 pax</div>
            <div class="hero-mini-lbl">Chip Eng Seng CNY · Suntec City</div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-scroll">
      <div class="hero-scroll-line"></div>
      <span class="hero-scroll-lbl">Scroll to explore</span>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="stats-bar">
    <div class="stat-item reveal"><div class="stat-num">1,400<span>pax</span></div><div class="stat-lbl">Marina Bay Sands · DSTA D&amp;D</div></div>
    <div class="stat-item reveal" data-d="1"><div class="stat-num">1,500<span>pax</span></div><div class="stat-lbl">Suntec City · Chip Eng Seng CNY</div></div>
    <div class="stat-item reveal" data-d="2"><div class="stat-num">1,100<span>pax</span></div><div class="stat-lbl">Ritz Carlton · SIT Staff Night</div></div>
    <div class="stat-item reveal" data-d="3"><div class="stat-num">800<span>pax</span></div><div class="stat-lbl">Shangri-La Hotel · SingHealth</div></div>
  </div>

  <!-- CLIENTS -->
  <div class="clients-strip">
    <span class="clients-label">Trusted by</span>
    <div class="client-names">
      <span class="client-name">DSTA</span>
      <span class="client-name">SingHealth</span>
      <span class="client-name">Mandai Wildlife Group</span>
      <span class="client-name">Singapore Institute of Technology</span>
      <span class="client-name">Chip Eng Seng</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section style="background:var(--midnight);">
    <div class="services-layout reveal">
      <div class="services-intro">
        <div class="eyebrow">What We Do</div>
        <h2 class="display-lg">Events built<br>for <em class="gold">your</em><br>organisation</h2>
        <p class="section-body">Every event is tailored to the culture, scale, and ambitions of the organisation behind it. No templates. No cookie-cutter production runs. Full concept to curtain call.</p>
        <a href="/pages/services" class="btn btn-outline" style="margin-top:32px;">
          All Services
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="service-list">
        <a href="/pages/services#dd" class="service-row">
          <div class="service-row-left"><span class="service-num">01</span><span class="service-name">Corporate Dinner &amp; Dance</span></div>
          <div class="service-row-right"><span class="service-row-desc">High-production D&amp;D for 200–2,000 guests. Full concept, entertainment, show-calling.</span><span class="service-tag">Flagship</span></div>
        </a>
        <a href="/pages/services#awards" class="service-row">
          <div class="service-row-left"><span class="service-num">02</span><span class="service-name">Awards Ceremonies</span></div>
          <div class="service-row-right"><span class="service-row-desc">Broadcast-quality staging, scripted show flow, moments built to be remembered.</span><span class="service-tag">Gov't &amp; Corp</span></div>
        </a>
        <a href="/pages/services#familyday" class="service-row">
          <div class="service-row-left"><span class="service-num">03</span><span class="service-name">Family Day Events</span></div>
          <div class="service-row-right"><span class="service-row-desc">Community events that bring employees and their families together at scale.</span><span class="service-tag">Community</span></div>
        </a>
        <a href="/pages/services#conferences" class="service-row">
          <div class="service-row-left"><span class="service-num">04</span><span class="service-name">Conferences &amp; Seminars</span></div>
          <div class="service-row-right"><span class="service-row-desc">End-to-end conference management — logistics, AV, MC, speaker coordination.</span><span class="service-tag">Corporate</span></div>
        </a>
        <a href="/pages/rallies" class="service-row">
          <div class="service-row-left"><span class="service-num">05</span><span class="service-name">Rallies™</span></div>
          <div class="service-row-right"><span class="service-row-desc">Our proprietary sports activation IP. Team-based, competitive, uniquely ours.</span><span class="service-tag">Proprietary IP</span></div>
        </a>
        <a href="/pages/services#teambuilding" class="service-row" style="border-bottom:none;">
          <div class="service-row-left"><span class="service-num">06</span><span class="service-name">Team Building</span></div>
          <div class="service-row-right"><span class="service-row-desc">Structured programmes that build culture and cohesion beyond the event itself.</span><span class="service-tag">Engagement</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section style="background:var(--navy);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="why-layout">
      <div class="why-items reveal">
        <div class="eyebrow" style="margin-bottom:40px;">Why Elitez Events</div>
        <div class="why-item">
          <div class="why-num">01</div>
          <div><div class="why-title">20+ Years of Show Expertise</div><div class="why-desc">Bryan Lim brings 20+ years of event production experience spanning MediaCorp productions, ExxonMobil and MPA Family Days, and gala dinners up to 3,000 pax. That depth shows on the night.</div></div>
        </div>
        <div class="why-item">
          <div class="why-num">02</div>
