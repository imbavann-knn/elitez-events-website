---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Portfolio — Elitez Events Singapore | Corporate Events Gallery"
  description="Elitez Events portfolio — DSTA, SIT, Mandai Wildlife, Hermes, Toyota, Allied World, L'Oreal and more across Singapore's corporate events landscape."
  canonical="https://events.elitez.asia/pages/portfolio"
  ogTitle="Portfolio — Elitez Events"
  ogDescription="80+ events. 60+ clients. DSTA, SIT, Mandai Wildlife, Hermes, Toyota, Allied World and more."
  activeNav="portfolio"
  isHome={false}
>
  <Fragment slot="head">
    <style is:global>
      /* ── FILTER BAR ─────────────────────────────────── */
      .filter-bar {
        padding: 32px var(--pad-x);
        background: var(--navy);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .filter-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--steel);
        margin-right: 8px;
        flex-shrink: 0;
      }
      .filter-btn {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--steel);
        border: 1px solid var(--border);
        background: none;
        padding: 8px 18px;
        cursor: pointer;
        transition: border-color 0.28s, color 0.28s, background 0.28s;
      }
      .filter-btn:hover,
      .filter-btn.active {
        border-color: var(--gold);
        color: var(--cream);
        background: var(--gold-dim);
      }

      /* ── PORTFOLIO STATS STRIP ──────────────────────── */
      .port-stats {
        background: var(--midnight);
        border-bottom: 1px solid var(--border);
        padding: 28px var(--pad-x);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 56px;
        flex-wrap: wrap;
      }
      .port-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .port-stat-num {
        font-family: var(--font-display);
        font-size: 36px;
        font-weight: 600;
        color: var(--gold);
        line-height: 1;
      }
      .port-stat-lbl {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--steel);
      }

      /* ── PORTFOLIO GRID ─────────────────────────────── */
      .port-section {
        padding: var(--pad-sect) var(--pad-x);
        background: var(--midnight);
      }
      .portfolio-masonry {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
      }
      .portfolio-card {
        background: var(--navy);
        position: relative;
        overflow: hidden;
        transition: opacity 0.3s;
      }
      .portfolio-card.hidden { display: none; }

      .portfolio-card-img {
        width: 100%;
        aspect-ratio: 4/3;
        background: var(--midnight);
        position: relative;
        overflow: hidden;
      }
      .portfolio-card-img img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease-out);
      }
      .portfolio-card:hover .portfolio-card-img img { transform: scale(1.04); }

      .port-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .port-placeholder::after {
        content: attr(data-lbl);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(240,235,224,0.18);
      }

      /* Unique gradient per card type */
      [data-type="dd"]         .port-placeholder { background: linear-gradient(145deg,#1a1428,#0d0e22 50%,#1a100a); }
      [data-type="awards"]     .port-placeholder { background: linear-gradient(145deg,#0c1a14,#081018); }
      [data-type="familyday"]  .port-placeholder { background: linear-gradient(145deg,#0e1820,#0a1218); }
      [data-type="conference"] .port-placeholder { background: linear-gradient(145deg,#0a1428,#100a1c); }
      [data-type="activation"] .port-placeholder { background: linear-gradient(145deg,#1c1208,#0e0c18); }
      [data-type="rallies"]    .port-placeholder { background: linear-gradient(145deg,#1a0c14,#0e1820); }

      .portfolio-card-meta {
        padding: 18px 22px 20px;
      }
      .portfolio-card-type {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 4px;
      }
      .portfolio-card-name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 17px;
        color: var(--cream);
        line-height: 1.2;
        margin-bottom: 4px;
      }
      .portfolio-card-detail {
        font-size: 12px;
        font-weight: 300;
        color: var(--steel);
      }
      .portfolio-card-year {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: rgba(201,146,58,0.5);
        margin-top: 6px;
      }

      .portfolio-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(201,146,58,0.04);
        opacity: 0;
        transition: opacity 0.35s;
        pointer-events: none;
      }
      .portfolio-card:hover::after { opacity: 1; }

      .portfolio-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: var(--gold);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s var(--ease-out);
        z-index: 1;
      }
      .portfolio-card:hover::before { transform: scaleX(1); }

      /* ── SECTOR TAGS ROW ────────────────────────────── */
      .sector-strip {
        background: var(--navy);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 48px var(--pad-x);
      }
      .sector-strip-inner {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
      }
      .sector-strip-title {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--steel);
        margin-bottom: 24px;
      }
      .sector-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
      }
      .sector-tag {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--cream);
        border: 1px solid var(--border);
        padding: 6px 14px;
      }

      @media (max-width: 768px) {
        .portfolio-masonry { grid-template-columns: 1fr 1fr; }
        .port-stats { gap: 32px; }
      }
      @media (max-width: 480px) {
        .portfolio-masonry { grid-template-columns: 1fr; }
      }
    </style>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Elitez Events Portfolio — Singapore Corporate Events",
      "description": "80+ corporate events across Singapore. DSTA, SIT, Mandai Wildlife Group, MOE, SingHealth, Toyota, Capitol Kempinski and 60+ clients.",
      "url": "https://events.elitez.asia/pages/portfolio",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://events.elitez.asia/" },
          { "@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://events.elitez.asia/pages/portfolio" }
        ]
      }
    }
    </script>
  </Fragment>

  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="page-hero-breadcrumb"><a href="/">Home</a><span>/</span> Portfolio</div>
      <div class="eyebrow reveal">Our Work</div>
      <h1 class="display-lg reveal" data-d="1">Events that<br>earned their<br><em class="gold">standing ovation</em></h1>
      <p class="reveal" data-d="2" style="margin-top:20px;font-size:15px;font-weight:300;color:var(--steel);line-height:1.85;max-width:520px;">Four years of corporate events across Singapore's most trusted names — government agencies, luxury brands, healthcare institutions, and Fortune 500 companies.</p>
    </div>
  </div>

  <!-- STATS STRIP -->
  <div class="port-stats">
    <div class="port-stat"><div class="port-stat-num">4+</div><div class="port-stat-lbl">Years Delivering</div></div>
    <div class="port-stat"><div class="port-stat-num">80+</div><div class="port-stat-lbl">Events Completed</div></div>
    <div class="port-stat"><div class="port-stat-num">60+</div><div class="port-stat-lbl">Clients Served</div></div>
    <div class="port-stat"><div class="port-stat-num">1,500</div><div class="port-stat-lbl">Largest Event (pax)</div></div>
  </div>

  <!-- FILTER -->
  <div class="filter-bar">
    <span class="filter-label">Filter by</span>
    <button class="filter-btn active" data-filter="all">All Events</button>
    <button class="filter-btn" data-filter="dd">Dinner &amp; Dance</button>
    <button class="filter-btn" data-filter="awards">Awards</button>
    <button class="filter-btn" data-filter="familyday">Family Day</button>
    <button class="filter-btn" data-filter="conference">Conference</button>
    <button class="filter-btn" data-filter="activation">Brand Activation</button>
    <button class="filter-btn" data-filter="rallies">Rallies™</button>
  </div>

  <!-- PORTFOLIO GRID -->
  <section class="port-section">
    <div class="portfolio-masonry reveal" id="portfolioGrid">

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/dsta-dd-2024.jpg" alt="DSTA Dinner and Dance 2024 by Elitez Events Singapore" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">DSTA D&amp;D 2024</div><div class="portfolio-card-detail">1,400 pax</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/mandai-dd-2024.jpg" alt="Mandai Wildlife Group Dinner and Dance by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">Mandai Wildlife Group</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/sit-dd-2024.jpg" alt="SIT Annual Staff Night by Elitez Events Singapore" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">SIT Annual Staff Night</div><div class="portfolio-card-detail">1,100 pax</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="conference">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/byteplus-conference-2024.png" alt="BytePlus Sales Kick-Off Conference by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Conference</div><div class="portfolio-card-name">BytePlus Sales Kick-Off</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="familyday">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/morrison-familyday-2024.jpg" alt="Morrison Express Family Day by Elitez Events Singapore" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Family Day</div><div class="portfolio-card-name">Morrison Express</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="awards">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/mandai-awards-2024.png" alt="Mandai Wildlife Group Awards Ceremony by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Awards Ceremony</div><div class="portfolio-card-name">Mandai Wildlife Group</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/moe-dd-2023.jpg" alt="MOE Ministry of Education Dinner and Dance by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">MOE Dinner &amp; Dance</div><div class="portfolio-card-year">2023</div></div>
      </div>

      <div class="portfolio-card" data-type="awards">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/saesl-awards-2024.jpg" alt="SAESL Groundbreaking Awards Ceremony by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Awards Ceremony</div><div class="portfolio-card-name">SAESL Groundbreaking</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/toyota-dd-2023.jpg" alt="Toyota Motor Asia Dinner and Dance by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">Toyota Motor Asia</div><div class="portfolio-card-year">2023</div></div>
      </div>

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/singhealth-dd-2024.jpg" alt="SingHealth Allied Health Day by Elitez Events Singapore" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">SingHealth Allied Health Day</div><div class="portfolio-card-detail">800 pax</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="familyday">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/hongleong-familyday-2024.jpg" alt="Hong Leong Club Family Day by Elitez Events Singapore" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Family Day</div><div class="portfolio-card-name">Hong Leong Club</div><div class="portfolio-card-year">2024</div></div>
      </div>

      <div class="portfolio-card" data-type="dd">
        <div class="portfolio-card-img"><img src="/assets/img/portfolio/capitol-dd-2023.jpg" alt="Capitol Kempinski Dinner and Dance by Elitez Events" loading="lazy" style="object-position:50% 50%"></div>
        <div class="portfolio-card-meta"><div class="portfolio-card-type">Dinner &amp; Dance</div><div class="portfolio-card-name">Capitol Kempinski</div><div class="portfolio-card-year">2023</div></div>
      </div>

    </div>
  </section>

  <!-- SECTOR TAGS -->
  <div class="sector-strip">
    <div class="sector-strip-inner">
      <div class="sector-strip-title">Industries we've served</div>
      <div class="sector-tags">
        <span class="sector-tag">Government &amp; Defence</span>
        <span class="sector-tag">Healthcare</span>
        <span class="sector-tag">Education</span>
        <span class="sector-tag">Technology</span>
        <span class="sector-tag">Finance &amp; Insurance</span>
        <span class="sector-tag">Luxury &amp; Hospitality</span>
        <span class="sector-tag">Automotive</span>
        <span class="sector-tag">Logistics &amp; Shipping</span>
        <span class="sector-tag">Semiconductor</span>
        <span class="sector-tag">Energy &amp; Engineering</span>
        <span class="sector-tag">FMCG &amp; Retail</span>
        <span class="sector-tag">Aerospace</span>
        <span class="sector-tag">Telco</span>
        <span class="sector-tag">E-Commerce</span>
      </div>
    </div>
  </div>

  <section class="cta-section" data-ghost="WORK">
    <div class="cta-inner reveal">
      <div class="cta-eyebrow">Add your event to this list</div>
      <div class="cta-title">Let's create something<br><em>worth remembering.</em></div>
      <div class="btn-pair btn-pair-center">
        <a href="/pages/contact" class="btn btn-gold">Get a Quote</a>
        <a href="/pages/services" class="btn btn-outline">Our Services</a>
      </div>
    </div>
  </section>

  <script is:inline>
  (function () {
    var btns  = document.querySelectorAll('.filter-btn');
    var cards = document.querySelectorAll('.portfolio-card');

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var f = btn.dataset.filter;
        cards.forEach(function (card) {
          card.classList.toggle('hidden', f !== 'all' && card.dataset.type !== f);
        });
      });
    });
  })();
  </script>
</Layout>
