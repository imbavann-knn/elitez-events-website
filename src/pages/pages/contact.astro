---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Contact — Elitez Events"
  description="Contact Elitez Events — enquire about your corporate D&D, awards ceremony, family day, Rallies™ or conference in Singapore."
  canonical="https://events.elitez.asia/pages/contact"
  ogTitle="Get a Quote — Elitez Events"
  ogDescription="Tell us about your event. We respond within 24 hours. No commitment required."
  activeNav="contact"
  isHome={false}
>
  <Fragment slot="head">
    <style is:global>
      /* ── CONTACT LAYOUT ─────────────────────────────── */
      .contact-layout {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 96px;
        align-items: start;
      }
      .contact-aside { position: sticky; top: 100px; }

      .contact-info-block {
        margin-bottom: 48px;
      }
      .contact-info-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 22px;
        color: var(--cream);
        margin-bottom: 24px;
      }
      .contact-info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
      .contact-info-item:first-of-type { border-top: 1px solid var(--border); }
      .contact-info-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold);
      }
      .contact-info-value {
        font-size: 14px;
        font-weight: 300;
        color: var(--cream);
        line-height: 1.6;
      }
      .contact-info-value a {
        text-decoration: none;
        transition: color 0.28s;
      }
      .contact-info-value a:hover { color: var(--gold); }

      .contact-direct {
        margin-top: 40px;
        background: var(--gold-dim);
        border: 1px solid var(--gold-border);
        padding: 28px;
      }
      .contact-direct-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 12px;
      }
      .contact-direct-name {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 20px;
        color: var(--cream);
        margin-bottom: 4px;
      }
      .contact-direct-title {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--steel);
        margin-bottom: 16px;
      }
      .contact-direct-links {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .contact-direct-links a {
        font-size: 13px;
        font-weight: 300;
        color: var(--cream);
        text-decoration: none;
        transition: color 0.28s;
      }
      .contact-direct-links a:hover { color: var(--gold); }

      /* ── FORM ────────────────────────────────────────── */
      .contact-form {
        background: var(--navy);
        border: 1px solid var(--border);
        padding: 48px;
      }
      .form-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 28px;
        color: var(--cream);
        margin-bottom: 8px;
      }
      .form-subtitle {
        font-size: 14px;
        font-weight: 300;
        color: var(--steel);
        margin-bottom: 40px;
        line-height: 1.6;
      }
      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
      }
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
      }
      .form-group.full { grid-column: span 2; }
      label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--steel);
      }
      input, select, textarea {
        background: var(--midnight);
        border: 1px solid var(--border);
        color: var(--cream);
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 300;
        padding: 14px 18px;
        outline: none;
        transition: border-color 0.28s;
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
      }
      input:focus,
      select:focus,
      textarea:focus { border-color: var(--gold); }
      input::placeholder,
      textarea::placeholder { color: var(--steel); opacity: 0.5; }

      select {
        background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%238A8FA8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 16px center;
        padding-right: 40px;
        cursor: pointer;
      }
      select option { background: var(--midnight); }
      textarea { resize: vertical; min-height: 140px; line-height: 1.6; }

      .form-submit {
        width: 100%;
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--midnight);
        background: var(--gold);
        border: none;
        padding: 18px;
        cursor: pointer;
        transition: background 0.28s, transform 0.2s;
        margin-top: 8px;
      }
      .form-submit:hover { background: var(--gold-light); transform: translateY(-1px); }

      .form-disclaimer {
        font-size: 11px;
        font-weight: 300;
        color: var(--steel);
        margin-top: 16px;
        line-height: 1.6;
        text-align: center;
      }

      /* ── RESPONSE TIME STRIP ─────────────────────────── */
      .response-strip {
        background: var(--navy);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 32px var(--pad-x);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 48px;
        flex-wrap: wrap;
      }
      .response-item {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .response-dot {
        width: 8px; height: 8px;
        background: var(--gold);
        border-radius: 50%;
        flex-shrink: 0;
      }
      .response-text {
        font-size: 13px;
        font-weight: 300;
        color: var(--steel);
      }
      .response-text strong { color: var(--cream); font-weight: 500; }

      @media (max-width: 1024px) {
        .contact-layout { grid-template-columns: 1fr; gap: 56px; }
        .contact-aside { position: static; }
      }
      @media (max-width: 600px) {
        .form-row { grid-template-columns: 1fr; }
        .form-group.full { grid-column: span 1; }
        .contact-form { padding: 28px 24px; }
      }
    </style>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home",    "item": "https://events.elitez.asia/" },
            { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://events.elitez.asia/pages/contact" }
          ]
        },
        {
          "@type": "ContactPage",
          "name": "Contact Elitez Events — Get a Quote",
          "url": "https://events.elitez.asia/pages/contact",
          "description": "Contact Elitez Events to get a quote for your corporate Dinner & Dance, Awards Ceremony, Family Day, Conference or Team Building event in Singapore.",
          "mainEntity": {
            "@type": "LocalBusiness",
            "name": "Elitez Events",
            "telephone": "+6581800994",
            "email": "eevann.seah@elitez.asia",
            "address": { "@type": "PostalAddress", "addressCountry": "SG", "addressLocality": "Singapore" }
          }
        }
      ]
    }
    </script>
  </Fragment>

  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="page-hero-breadcrumb"><a href="/">Home</a><span>/</span> Contact</div>
      <div class="eyebrow reveal">Get in Touch</div>
      <h1 class="display-lg reveal" data-d="1">Every great event<br>starts with a<br><em class="gold">conversation.</em></h1>
      <p class="reveal" data-d="2" style="margin-top:20px;font-size:15px;font-weight:300;color:var(--steel);line-height:1.85;max-width:520px;">Tell us about your event and we'll come back with ideas, a timeline, and a quote. No obligation — just a starting point.</p>
    </div>
  </div>

  <!-- RESPONSE STRIP -->
  <div class="response-strip">
    <div class="response-item"><div class="response-dot"></div><div class="response-text"><strong>Within 24 hours</strong> — typical response time to new enquiries</div></div>
    <div class="response-item"><div class="response-dot"></div><div class="response-text"><strong>No pricing on this site</strong> — all quotes are tailored to your event</div></div>
    <div class="response-item"><div class="response-dot"></div><div class="response-text"><strong>No commitment required</strong> — your enquiry is a conversation, not a contract</div></div>
  </div>

  <!-- CONTACT FORM + INFO -->
  <section style="background:var(--midnight);">
    <div class="contact-layout">
      <div class="contact-aside reveal">
        <div class="contact-info-block">
          <div class="contact-info-title">Our details</div>
          <div class="contact-info-item"><div class="contact-info-label">Office</div><div class="contact-info-value">2 Kallang Avenue #03-08<br>CT Hub, Singapore 188613</div></div>
          <div class="contact-info-item"><div class="contact-info-label">Email</div><div class="contact-info-value"><a href="mailto:eevann.seah@elitez.asia">eevann.seah@elitez.asia</a></div></div>
          <div class="contact-info-item"><div class="contact-info-label">Phone</div><div class="contact-info-value"><a href="tel:+6581800994">+65 8180 0994</a></div></div>
          <div class="contact-info-item"><div class="contact-info-label">Part of</div><div class="contact-info-value">Elitez Group of Companies</div></div>
        </div>

        <div class="contact-direct">
          <div class="contact-direct-label">Speak directly with</div>
          <div class="contact-direct-name">Sam Neo</div>
          <div class="contact-direct-title">Assistant Manager</div>
          <div class="contact-direct-links">
            <a href="tel:+6597271292">+65 9727 1292</a>
            <a href="mailto:sam.neo@elitez.asia">sam.neo@elitez.asia</a>
          </div>
        </div>
      </div>

      <div class="reveal" data-d="1">
        <form class="contact-form" id="enquiry-form" action="https://formsubmit.co/fmcg@elitez.asia" method="POST">
          <!-- Formsubmit config -->
          <input type="hidden" name="_replyto"   id="fs-replyto">
          <input type="hidden" name="_subject"   id="fs-subject">
          <input type="hidden" name="_next"      value="https://events.elitez.asia/pages/contact?sent=1">
          <input type="hidden" name="_captcha"   value="false">
          <input type="hidden" name="_template"  value="table">

          <div class="form-title">Send us an enquiry</div>
          <p class="form-subtitle">Fill in as much or as little as you know at this stage. We'll follow up with questions.</p>

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" placeholder="Full name" required />
            </div>
            <div class="form-group">
              <label for="company">Company / Organisation *</label>
              <input type="text" id="company" name="company" placeholder="Organisation name" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required />
            </div>
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="+65 XXXX XXXX" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="event-type">Event Type *</label>
              <select id="event-type" name="Event Type" required>
                <option value="" disabled selected>Select event type</option>
                <option value="Corporate Dinner &amp; Dance">Corporate Dinner &amp; Dance</option>
                <option value="Awards Ceremony">Awards Ceremony</option>
                <option value="Family Day">Family Day</option>
                <option value="Conference / Seminar">Conference / Seminar</option>
                <option value="Rallies™">Rallies™</option>
                <option value="Team Building">Team Building</option>
                <option value="Other / Not sure yet">Other / Not sure yet</option>
              </select>
            </div>
            <div class="form-group">
              <label for="pax">Estimated Guest Count</label>
              <select id="pax" name="Guest Count">
                <option value="" disabled selected>Approximate size</option>
                <option value="Under 100 pax">Under 100 pax</option>
                <option value="100 – 300 pax">100 – 300 pax</option>
                <option value="300 – 600 pax">300 – 600 pax</option>
                <option value="600 – 1,000 pax">600 – 1,000 pax</option>
                <option value="1,000+ pax">1,000+ pax</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="date">Preferred Event Date</label>
              <input type="date" id="date" name="Preferred Date" />
            </div>
            <div class="form-group">
              <label for="venue">Venue (if known)</label>
              <input type="text" id="venue" name="Venue" placeholder="Venue or preferred area" />
            </div>
          </div>

          <div class="form-group">
            <label for="message">Tell Us About Your Event</label>
            <textarea id="message" name="Message" placeholder="Theme ideas, past event history, key requirements, anything that helps us understand what you need..."></textarea>
          </div>

          <button type="submit" class="form-submit">Send Enquiry</button>
          <div class="form-disclaimer">No pricing on this site. All quotes are tailored. We'll respond within 24 hours.</div>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Also log every enquiry into the shared Elitez leads sheet (labelled by source).
    // The form still submits to FormSubmit as before — sendBeacon fires reliably even
    // as the page navigates away. Paste the Apps Script Web App /exec URL below.
    const LEADS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbxHmZd45kiKDmZCkzdNNznZUvLRoiYYsHbrnTHKXnkH3nH_PST6fKfvgoRN1TW71PKa/exec';
    document.getElementById('enquiry-form')?.addEventListener('submit', function () {
      try {
        if (!/^https:\/\//.test(LEADS_ENDPOINT)) return;
        const p = new URLSearchParams(); p.set('source', 'Events Website');
        new FormData(this).forEach((v, k) => { if (k[0] !== '_') p.append(k, v); });
        navigator.sendBeacon(LEADS_ENDPOINT, p);
      } catch (e) {}
    });
  </script>
</Layout>
